#!/usr/bin/env python3
"""dbm entry script — run ./bin/dbm from the project directory,
or `python3 -m dbm` from the project directory."""
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from dbm.cli import main
if __name__ == "__main__":
    raise SystemExit(main())
