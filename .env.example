# ==============================================================================
# Otter MCP Daemon - Environment Configuration Template
# Sao chép tệp này thành .env và chỉnh sửa theo môi trường của bạn:
#   cp .env.example .env
# ==============================================================================

# Cổng mạng của Otter Daemon (Mặc định: 1993)
PORT=1993

# Chế độ Debug (in log chi tiết ra console)
DEBUG=false

# ==============================================================================
# CẤU HÌNH TRÌNH DUYỆT (DUAL-ENGINE: CDP + EXTENSION)
# ==============================================================================
# Cổng Chrome DevTools Protocol (CDP) để điều khiển trình duyệt trực tiếp (Mặc định: 9222)
CDP_PORT=9222

# Đường dẫn file thực thi Chrome (nếu muốn tùy chỉnh ngoài đường dẫn mặc định)
# OTTER_CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

# Thư mục lưu User Data/Profile của Chrome
# OTTER_CHROME_USER_DATA_DIR="storage/browser-profile"

# ==============================================================================
# TÙY CHỌN: TÍCH HỢP ANTIDETECT BROWSER (GPM LOGIN / ADSLOGIN)
# ==============================================================================
# Nếu bạn dùng GPM Login để quản lý nhiều profile/tài khoản:
GPM_API_URL=http://127.0.0.1:9495
# GPM_PROFILE_ID=your-gpm-profile-uuid-here

# ==============================================================================
# BẢO MẬT & TUNNEL
# ==============================================================================
# Bỏ qua tạo Cloudflare Tunnel công khai (chỉ chạy local): true / false
NO_TUNNEL=false

